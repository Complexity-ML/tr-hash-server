[Unit]
Description=TR-Hash-i64 home inference server
Documentation=https://github.com/Complexity-ML/TR-Hash-i64
Wants=network-online.target nvidia-persistenced.service
After=network-online.target nvidia-persistenced.service
StartLimitIntervalSec=5min
StartLimitBurst=4

[Service]
Type=simple
User=boris
Group=boris
EnvironmentFile=/etc/tr-hash-server/server.env
ExecStartPre=/usr/local/bin/tr-hash-server wait-gpu --timeout 180
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle --who=TR-Hash-Server --why=TR-HASH-eGPU-inference --mode=block /usr/local/bin/tr-hash-server launch
Restart=on-failure
RestartSec=20s
TimeoutStartSec=10min
TimeoutStopSec=90s
ExecStopPost=/usr/bin/sleep 10
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
