[Unit]
Description=TR-Hash training TensorBoard
Documentation=https://github.com/Complexity-ML/tr-hash-server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=boris
Group=boris
EnvironmentFile=/etc/tr-hash-server/server.env
ExecStart=/usr/local/bin/tr-hash-server tensorboard
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
