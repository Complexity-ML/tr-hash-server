# Runtime installed in Boris's existing PyTorch virtual environment.
TR_HASH_EXECUTABLE=/home/boris/pytorch/bin/tr-hash-i64
TR_HASH_WORKING_DIRECTORY=/home/boris/TR-Hash-i64
TR_HASH_SERVICE_USER=boris

# Public SFT v1 (32K) served without weight quantization.
TR_HASH_MODEL=tr-hash-moe-200m
TR_HASH_CHECKPOINT=
TR_HASH_DTYPE=float32
TR_HASH_DEVICE=cuda
TR_HASH_QUANTIZATION=none

# GPU 0 is the display GTX 1660 Ti. GPU 1 is the headless RTX 5060 Ti 16 GB.
TR_HASH_DEVICES=1
TR_HASH_CUDA_DEVICE_ORDER=PCI_BUS_ID
# This GPU is connected through a Thunderbolt eGPU enclosure. Require the
# device to remain continuously visible before creating the long-lived CUDA
# context used by TR-Hash-i64.
TR_HASH_EGPU_STABLE_SECONDS=15
# Start conservatively on this Blackwell card; enable graphs after a successful
# eager-generation smoke test on the installed driver/PyTorch combination.
TR_HASH_CUDA_GRAPHS=0

# LAN endpoint. Use 127.0.0.1 if remote access is not required.
TR_HASH_HOST=192.168.1.16
TR_HASH_PORT=7860
TR_HASH_API_KEY_FILE=/etc/tr-hash-server/api.key

# Conservative interactive profile for the 16 GB card.
TR_HASH_MAX_BATCH_SIZE=8
TR_HASH_CHUNK_SIZE=256
TR_HASH_MAX_KV_BLOCKS=256
TR_HASH_MAX_PENDING=32

TR_HASH_READY_URL=http://192.168.1.16:7860/ready
TR_HASH_HEALTH_FAILURES=3
